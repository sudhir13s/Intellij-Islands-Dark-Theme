{
  "name": "intellij-islands-dark-theme",
  "displayName": "Intellij Islands Dark Theme",
  "description": "IntelliJ & Islands Dark Theme for Antigravity & VS Code",
  "version": "1.2.1",
  "publisher": "sudhir",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "intellij",
    "pycharm",
    "webstorm",
    "theme",
    "dark",
    "jetbrains"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Intellij Islands Dark Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/intellij-islands-dark-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "python-builtins.injection.islands",
        "path": "./syntaxes/python-builtins.injection.json",
        "injectTo": [
          "source.python"
        ]
      }
    ]
  }
}