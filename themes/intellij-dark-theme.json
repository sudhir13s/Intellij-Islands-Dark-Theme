  "tokenColors": [
    {
      "name": "Python Built-in Types (str, list, dict, frozenset, int, set, tuple, bool)",
      "scope": [
        "support.type.python",
        "support.class.builtin.python",
        "support.function.builtin.python",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#4a88c7"
      }
    },
    {
      "name": "Python self and cls (Purple in Parameters & Body)",
      "scope": [
        "variable.language.special.self.python",
        "variable.language.special.cls.python",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python",
        "variable.parameter.cls.python",
        "variable.parameter.self.python"
      ],
      "settings": {
        "foreground": "#9876aa"
      }
    },
    {
      "name": "Python Parameters and Keyword Arguments (Gray - distinct from value)",
      "scope": [
        "variable.parameter",
        "variable.parameter.function-call.python",
        "meta.function-call.arguments.python variable.parameter"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Python Classes and Fields (Soft Gray)",
      "scope": [
        "entity.name.type.class.python",
        "entity.other.inherited-class.python",
        "meta.attribute.python",
        "variable.other.property.python"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Keywords, Modifiers, Java Primitives",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other",
        "storage.modifier",
        "storage.type.primitive.java",
        "storage.type.java",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "name": "Boolean and Null Constants (including Python None, True, False)",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.python",
        "constant.language"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "name": "Java Classes, Records, Interfaces (Soft Gray)",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.interface",
        "entity.name.type",
        "support.type",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Method and Constructor Definitions (Blue)",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "entity.name.function.constructor",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#4a88c7"
      }
    },
    {
      "name": "Static Method Definitions (Blue Italic)",
      "scope": [
        "entity.name.function.member.static"
      ],
      "settings": {
        "foreground": "#4a88c7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Method Calls (Soft Gray)",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.method-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Java Fields and Record Parameters (Purple)",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.record.constructor variable.parameter",
        "meta.record.parameters variable.parameter"
      ],
      "settings": {
        "foreground": "#9876aa"
      }
    },
    {
      "name": "Java Static Fields (Purple Italic)",
      "scope": [
        "variable.other.property.static"
      ],
      "settings": {
        "foreground": "#9876aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotations and Decorators (Yellow)",
      "scope": [
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator.python",
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#e0b44c"
      }
    },
    {
      "name": "Package Names (Soft Gray)",
      "scope": [
        "meta.package.java entity.name.type",
        "meta.package.java variable"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#5f9e68"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language.numeric"
      ],
      "settings": {
        "foreground": "#289ca8"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line"
      ],
      "settings": {
        "foreground": "#686c73"
      }
    },
    {
      "name": "Doc Comments",
      "scope": [
        "comment.block.documentation",
        "comment.block"
      ],
      "settings": {
        "foreground": "#52785e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#9876aa"
      }
    },
    {
      "name": "YAML Keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "name": "JSX React Components",
      "scope": [
        "support.class.component",
        "support.class.component.js.jsx",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#2fbaa3"
      }
    }
  ],
