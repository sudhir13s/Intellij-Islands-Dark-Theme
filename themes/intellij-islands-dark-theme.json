  "tokenColors": [
    {
      "name": "Default text, operators, punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "storage.type.function.arrow",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a7e85"
      }
    },
    {
      "name": "Doc comments, Python docstrings",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5f826b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags (@param, @return)",
      "scope": [
        "comment.block.documentation storage.type",
        "comment.block.documentation keyword",
        "comment.block.javadoc keyword",
        "keyword.other.documentation",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#67a37c",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comment tag values",
      "scope": [
        "comment.block.documentation variable",
        "comment.block.documentation entity.name.type",
        "comment.block.javadoc variable.parameter",
        "variable.other.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#abadb3",
        "fontStyle": ""
      }
    },
    {
      "name": "TODO markers",
      "scope": [
        "keyword.codetag.notation",
        "comment keyword.todo"
      ],
      "settings": {
        "foreground": "#8bb33d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, modifiers, storage, language constants",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "variable.language.this",
        "variable.language.super",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "support.type.primitive",
        "support.type.builtin.ts",
        "support.type.builtin.tsx"
      ],
      "settings": {
        "foreground": "#cf8e6d"
      }
    },
    {
      "name": "Java type references (String, List<T>) and import paths are not keywords",
      "scope": [
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java",
        "storage.modifier.import.java",
        "storage.modifier.package.java"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Java primitives are keywords",
      "scope": [
        "storage.type.primitive.java",
        "storage.type.primitive.array.java"
      ],
      "settings": {
        "foreground": "#cf8e6d"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.template",
        "storage.type.string.python",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6aab73"
      }
    },
    {
      "name": "String escapes and format placeholders",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "storage.type.format.python",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#cf8e6d"
      }
    },
    {
      "name": "JS/TS regex literals (/.../)",
      "scope": [
        "string.regexp",
        "string.regexp punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#42c3d4"
      }
    },
    {
      "name": "Python raw/regex strings read as strings",
      "scope": [
        "string.regexp.quoted",
        "string.regexp.quoted punctuation.definition.string",
        "string.regexp.quoted keyword",
        "string.regexp.quoted keyword.operator",
        "string.regexp.quoted constant.other",
        "string.regexp.quoted constant.character.set",
        "string.regexp.quoted support.other.match",
        "string.regexp.quoted punctuation",
        "string.regexp.quoted entity.name.tag"
      ],
      "settings": {
        "foreground": "#6aab73"
      }
    },
    {
      "name": "Python regex escapes (\\d, \\.)",
      "scope": [
        "string.regexp.quoted support.other.escape",
        "string.regexp.quoted constant.character.escape"
      ],
      "settings": {
        "foreground": "#cf8e6d"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit",
        "storage.type.number.python",
        "storage.type.imaginary.number.python"
      ],
      "settings": {
        "foreground": "#2aacb8"
      }
    },
    {
      "name": "Types, classes, interfaces, enums (references and declarations)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.namespace",
        "meta.package",
        "meta.import"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#16baac"
      }
    },
    {
      "name": "Function, method, constructor declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#56a8f5"
      }
    },
    {
      "name": "Function and method calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.method-call entity.name.function",
        "meta.function-call.generic",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Parameters and local variables",
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Fields, properties, object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.record.parameters variable.parameter"
      ],
      "settings": {
        "foreground": "#c77dbb"
      }
    },
    {
      "name": "Static fields, constants, enum members",
      "scope": [
        "variable.other.property.static",
        "variable.other.enummember",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#c77dbb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JS/TS globals (window, document, console, process)",
      "scope": [
        "support.variable.dom",
        "support.variable.object",
        "support.class.console"
      ],
      "settings": {
        "foreground": "#c77dbb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotations and decorators",
      "scope": [
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "meta.decorator variable.other.readonly"
      ],
      "settings": {
        "foreground": "#b3ae60"
      }
    },
    {
      "name": "Python: no field coloring for attributes",
      "scope": [
        "meta.attribute.python",
        "variable.other.property.python"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Python: self and cls",
      "scope": [
        "variable.language.special.self.python",
        "variable.language.special.cls.python",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#94558d"
      }
    },
    {
      "name": "Python: keyword arguments in calls",
      "scope": [
        "variable.parameter.function-call.python"
      ],
      "settings": {
        "foreground": "#aa4926"
      }
    },
    {
      "name": "Python: built-in names (print, len, str, int, ValueError)",
      "scope": [
        "support.function.builtin.python",
        "support.type.python",
        "support.type.exception.python"
      ],
      "settings": {
        "foreground": "#8888c6"
      }
    },
    {
      "name": "Python: built-ins used as decorators (@classmethod, @property, @staticmethod)",
      "scope": [
        "meta.function.decorator.python support.type.python",
        "meta.function.decorator.python support.function.builtin.python",
        "entity.name.function.decorator punctuation.separator.period"
      ],
      "settings": {
        "foreground": "#b3ae60"
      }
    },
    {
      "name": "Python: built-ins inside decorator arguments",
      "scope": [
        "meta.function.decorator.python meta.function-call.arguments.python support.type.python",
        "meta.function.decorator.python meta.function-call.arguments.python support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#8888c6"
      }
    },
    {
      "name": "Python: dunder names (__init__, __name__)",
      "scope": [
        "support.function.magic.python",
        "support.variable.magic.python"
      ],
      "settings": {
        "foreground": "#b200b2"
      }
    },
    {
      "name": "HTML/XML/JSX tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#d5b778"
      }
    },
    {
      "name": "JSX/TSX components and custom tags",
      "scope": [
        "support.class.component",
        "entity.name.tag.custom"
      ],
      "settings": {
        "foreground": "#2fbaa3"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#bababa"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#c77dbb"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "punctuation.support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c77dbb"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#cf8e6d"
      }
    },
    {
      "name": "YAML plain values",
      "scope": [
        "string.unquoted.plain.out.yaml"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "name": "Properties / INI keys (Spring application.properties)",
      "scope": [
        "keyword.other.definition.ini",
        "source.java-properties support.type.property-name"
      ],
      "settings": {
        "foreground": "#cf8e6d"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#cf8e6d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#56a8f5"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#6aab73"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#6aab73"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f75464"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f75464"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#bcbec4",
